#!/bin/sh
#
# Resets the browser-testing WordPress to a fresh install: drops all tables,
# reinstalls, clears uploads, and reactivates all plugins. Also bootstraps the
# dev-only files under the gitignored web/ on first run. Requires the dev
# database (docker compose up -d mysql).
#
# Usage: [DISABLE_COMMENTS_DEV_PORT=8080] bin/dev-reset

set -eu
cd "$(dirname "$0")/.."

PORT="${DISABLE_COMMENTS_DEV_PORT:-8080}"
URL="http://localhost:$PORT"

# --- Dev-only files (web/ is gitignored; this script is their canonical source) ---

if [ ! -f web/wp-config.php ]; then
    cat > web/wp-config.php <<'PHP'
<?php

// Dev-only config for browser testing, generated by bin/dev-reset.

// Composer autoloader
require_once dirname(__DIR__) . '/vendor/autoload.php';

if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/wp/');
}
// Derive the base URL from the request so the port is not baked in
// (bin/dev-server picks the port; CLI falls back to DISABLE_COMMENTS_DEV_PORT).
$devHost = $_SERVER['HTTP_HOST'] ?? ('localhost:' . (getenv('DISABLE_COMMENTS_DEV_PORT') ?: '8080'));
define('WP_CONTENT_DIR', __DIR__ . '/wp-content');
define('WP_HOME', "http://{$devHost}");
define('WP_SITEURL', WP_HOME . '/wp');
define('WP_CONTENT_URL', WP_HOME . '/wp-content');

define('DB_NAME', 'disable_comments_dev');
define('DB_USER', 'root');
define('DB_PASSWORD', 'password');
define('DB_HOST', '127.0.0.1:3310');
define('DB_CHARSET', 'utf8');
define('DB_COLLATE', '');
$table_prefix = 'wpdev_';

define('WP_DEBUG', true);
define('WP_DEBUG_LOG', true);
define('WP_DEBUG_DISPLAY', false);
define('WP_ENVIRONMENT_TYPE', 'local');
define('AUTOMATIC_UPDATER_DISABLED', true);

// Auth keys (dev only — do not use in production)
define('AUTH_KEY', 'disable-comments-dev-auth-key');
define('SECURE_AUTH_KEY', 'disable-comments-dev-secure-auth-key');
define('LOGGED_IN_KEY', 'disable-comments-dev-logged-in-key');
define('NONCE_KEY', 'disable-comments-dev-nonce-key');
define('AUTH_SALT', 'disable-comments-dev-auth-salt');
define('SECURE_AUTH_SALT', 'disable-comments-dev-secure-auth-salt');
define('LOGGED_IN_SALT', 'disable-comments-dev-logged-in-salt');
define('NONCE_SALT', 'disable-comments-dev-nonce-salt');

require_once ABSPATH . 'wp-settings.php';
PHP
    echo 'created:  web/wp-config.php'
fi

if [ ! -f web/index.php ]; then
    cat > web/index.php <<'PHP'
<?php

// Dev-only front controller, generated by bin/dev-reset.

define('WP_USE_THEMES', true);
require __DIR__ . '/wp/wp-blog-header.php';
PHP
    echo 'created:  web/index.php'
fi

# A real file, NOT a symlink to the repo root: wp_register_plugin_realpath()
# would map the plugin dir to the repo root — an ancestor of web/ — corrupting
# plugin_basename()/plugins_url() for every plugin under web/wp-content/plugins/.
if [ ! -f web/wp-content/plugins/disable-comments/wppack-disable-comments.php ]; then
    mkdir -p web/wp-content/plugins/disable-comments
    cat > web/wp-content/plugins/disable-comments/wppack-disable-comments.php <<'PHP'
<?php

/**
 * Plugin Name: WPPack Disable Comments
 * Description: Dev stub generated by bin/dev-reset — loads the plugin from the repository root.
 * Version: 1.0.0
 * Requires PHP: 8.2
 * Requires at least: 6.7
 * Author: WPPack
 * License: MIT
 */

declare(strict_types=1);

if (!defined('ABSPATH')) {
    exit;
}

require dirname(__DIR__, 4) . '/wppack-disable-comments.php';
PHP
    echo 'created:  web/wp-content/plugins/disable-comments/wppack-disable-comments.php'
fi

# --- Reset ---

vendor/bin/wp db reset --yes

rm -rf web/wp-content/uploads
mkdir -p web/wp-content/uploads

rm -f web/wp-content/debug.log

vendor/bin/wp core install \
    --url="$URL" \
    --title='Disable Comments Dev' \
    --admin_user=admin \
    --admin_password=password \
    --admin_email=admin@example.test \
    --skip-email

vendor/bin/wp plugin activate --all

# Seed content to exercise the plugin against: a published post with an
# approved comment, a pingback and a WooCommerce-style order note.
POST_ID=$(vendor/bin/wp post create --post_title='Discussion test post' --post_status=publish --post_content='Body' --porcelain)
vendor/bin/wp comment create --comment_post_ID="$POST_ID" --comment_content='Visible before activation' --comment_author=alice --comment_author_email=alice@example.test --comment_approved=1
vendor/bin/wp comment create --comment_post_ID="$POST_ID" --comment_content='A pingback' --comment_author=bob --comment_type=pingback --comment_approved=1
vendor/bin/wp comment create --comment_post_ID="$POST_ID" --comment_content='An order note' --comment_author=system --comment_type=order_note --comment_approved=1

echo
echo "Reset complete: $URL/wp/wp-admin/ (admin / password)"
echo "Server: bin/dev-server"
